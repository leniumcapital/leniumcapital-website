// Supabase Postgres via Vercel integration (auto-synced env vars):
//   POSTGRES_PRISMA_URL       — pooled, for the running app
//   POSTGRES_URL_NON_POOLING  — direct, for migrations (db push / migrate)
// If connecting manually, set those same names in .env — see .env.example.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  password          String?
  name              String
  phone             String?
  avatarUrl         String?
  twoFactorEnabled  Boolean          @default(false)
  twoFactorMethod   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  accounts          TradingAccount[]
  orders            Order[]
  billingOrders     BillingOrder[]
}

model TradingAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType     String
  tier            Int
  balance         Int
  challengeStatus String
  isPrimary       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
  billingOrders   BillingOrder[]

  @@index([userId])
  @@unique([userId, accountType])
}

model BillingOrder {
  id            String          @id @default(cuid())
  orderNumber   String          @unique
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String?
  account       TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  planType      String          // "challenge" | "reset"
  tierSize      Int
  balance       Int
  price         Int
  status        String          @default("pending") // "pending" | "paid"
  addons        String          @default("[]")
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model Order {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  marketTicker String
  question     String?
  category     String?
  direction    String
  size         Float
  entryPrice   Float
  exitPrice    Float?
  simulated    Boolean        @default(true)
  status       String         @default("open")
  openedAt     DateTime       @default(now())
  closedAt     DateTime?

  @@index([userId])
  @@index([accountId])
  @@index([status])
}

model IconMapping {
  id            String   @id @default(cuid())
  nameKey       String   @map("name_key") @db.VarChar(500)
  displayName   String   @map("display_name") @db.VarChar(500)
  imageUrl      String   @map("image_url") @db.Text
  category      String   @db.VarChar(100)
  source        String   @db.VarChar(50)
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  failCount     Int      @default(0) @map("fail_count") @db.SmallInt
  isInvalidated Boolean  @default(false) @map("is_invalidated")

  @@unique([nameKey, category])
  @@index([category])
  @@index([isInvalidated])
  @@map("icon_mappings")
}
