# ─── Supabase via Vercel integration (auto-synced) ───────────────────────────
# When you connect Supabase in Vercel, these are set automatically:
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Manual Supabase setup (if not using Vercel integration):
# POSTGRES_PRISMA_URL  = Transaction pooler, port 6543, add ?pgbouncer=true
# POSTGRES_URL_NON_POOLING = Direct connection, port 5432

# ─── Auth.js (required in production) ────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public site URL (Auth.js v5). Use http://localhost:3000 locally.
AUTH_URL="http://localhost:3000"

# ─── Google OAuth (Sign in with Google) ─────────────────────────────────────
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# Authorized JavaScript origins: https://lenium.capital, http://localhost:3000
# Authorized redirect URIs:
#   https://lenium.capital/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Legacy NextAuth env names (optional — Auth.js also reads these as fallbacks):
# NEXTAUTH_URL="https://lenium.capital"
# NEXTAUTH_SECRET="same-value-as-AUTH_SECRET"

# ─── Icon system ─────────────────────────────────────────────────────────────
# Comma-separated admin emails for /api/icons/admin
ADMIN_EMAILS="kyryl@lenium.capital"
# Free TMDB API key for Culture category icon resolution (themoviedb.org)
TMDB_API_KEY=""

# ─── Kalshi (optional — public API works without a key) ────────────────────────
# KALSHI_API_BASE="https://api.elections.kalshi.com/trade-api/v2"
